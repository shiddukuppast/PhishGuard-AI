# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.5xf4qiv.mongodb.net/phishguard?retryWrites=true&w=majority
DATABASE_NAME=phishguard

# Authentication & JWT Configuration
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client & Cookie Configuration
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# External Threat Intelligence APIs (Optional - services will report unavailable if unset)
PHISHTANK_API_KEY=
OPENPHISH_API_KEY=

# ML Model Artifact Path
MODEL_PATH=../model/artifacts/phishing_model.pkl
